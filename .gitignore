sevii/tile_mapping/sevii_tileset.json
sevii/tile_mapping/mid_lock.json
sevii/tile_mapping/sources/*
!sevii/tile_mapping/sources/README.md
!sevii/tile_mapping/sources/sources_manifest.json

# PokéAPI / sprite download cache (lives under the game repo tools/.cache)
tools/.cache/
tools/cache/

# Generated Python bytecode
__pycache__/
*.py[cod]
*$py.class

